# Runtime
DI_DATABASE_URL=sqlite:///data/decisions.db
DI_AUDIT_PATH=data/audit.jsonl
DI_POLICY_PATH=policies/v1.json

# Authentication: disabled | jwt
DI_AUTH_MODE=disabled
DI_DEV_SUBJECT=dev-user

# JWT mode
DI_JWT_SECRET=change-me
DI_JWT_ISSUER=https://issuer.example
DI_JWT_AUDIENCE=decision-engine
DI_JWT_ALGORITHM=HS256

# Telemetry
DI_OTEL_ENABLED=false
